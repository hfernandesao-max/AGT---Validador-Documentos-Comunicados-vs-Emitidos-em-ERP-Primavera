# Copie para .env e preencha. O .env e a chave privada nunca entram no Git.

# producao ou homologacao
AGT_AMBIENTE=producao
AGT_NIF=

# Credenciais de acesso aos serviços emitidas pela AGT
AGT_UTILIZADOR=
AGT_SENHA=

# Chave RSA privada do emissor (a mesma usada pelo Primavera para comunicar)
AGT_CHAVE_PRIVADA=chaves/privada.pem

# Dados do software certificado (softwareInfo)
AGT_PRODUCT_ID=
AGT_PRODUCT_VERSION=
AGT_SOFTWARE_VALIDATION_NUMBER=
AGT_JWS_SOFTWARE_SIGNATURE=
